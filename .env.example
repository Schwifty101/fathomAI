# Copy to .env.local (gitignored). Required for the app, `npm run rls:test`, `seed:load` and `seed:clips`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (usage metering, summary writes, seed scripts). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables live regenerate and live Ask. Without it Ask uses canned/extractive answers
# and the Regenerate button is disabled; nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Seed generation only (`npm run seed:gen`, uses your logged-in `claude` CLI, not an API key)
SEED_MODEL=sonnet

# Optional: public site URL for social-card metadata. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is
# used automatically; locally it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Optional: only needed if supabase/.temp/project-ref is absent (the target guard in
# scripts/guard-target.ts refuses to run without a linked or expected project ref).
EXPECT_SUPABASE_REF=

# NOT here: SUPABASE_DB_PASSWORD lives in the repo-root .env and is read only by the `supabase` CLI
# (db push / migration list). The app never uses it.
